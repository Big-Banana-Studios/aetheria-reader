# The source PDFs are 1.9 GB — far too much for a static host, and not
# what the reader needs. Only the cleaned text in library/ is published;
# regenerate it with tools/build_library.py.
Buddism books/
*.pdf
build.log

# The original single-file reader this PWA grew out of
AetheriaReader.html

# Local scratch
_*.mjs
_*.html
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# The translation toolchain: a venv with CUDA torch, and the per-segment
# cache that lets an interrupted run resume. Neither belongs in the repo;
# the English text they produce goes in library/ like any other book.
tools/.venv/
tools/.translate-cache/
